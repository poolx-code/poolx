{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": false,
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@poolx/sdk": ["packages/sdk/src"],
      "@poolx/sdk/*": ["packages/sdk/src/*"],
      "@poolx/types": ["packages/types/src"],
      "@poolx/types/*": ["packages/types/src/*"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
